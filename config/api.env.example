DATABASE_URL=
DATABASE_CA_FILE=/run/secrets/database-ca.pem
DATABASE_PASSWORD_FILE=/run/secrets/database-password
KEY_PROVIDER=local
LOCAL_KEY_VERSION=v1
LOCAL_SIGNING_KEY_FILE=/run/secrets/license-signing.pem
LOCAL_WRAPPING_KEY_FILE=/run/secrets/wrapping-key
AUTH_PROVIDER=local
LOCAL_AUTH_PUBLIC_KEY_FILE=/run/secrets/auth-public.pem
LOCAL_AUTH_ISSUER=drm-local
LOCAL_AUTH_AUDIENCE=drm-api
# Optional external adapter configuration:
OPENBAO_ADDR=https://bao.example.internal/
OPENBAO_TOKEN_FILE=/run/secrets/openbao-token
OPENBAO_SIGNING_KEY_NAME=license-sign
OPENBAO_SIGNING_KEY_VERSION=1
OPENBAO_TENANT_KEYS_JSON={"00000000-0000-4000-8000-000000000001":{"activeKeyName":"tenant-00000000-0000-4000-8000-000000000001","permittedKeyNames":["tenant-00000000-0000-4000-8000-000000000001"]}}
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY_FILE=/run/secrets/object-access-key
OBJECT_STORE_SECRET_KEY_FILE=/run/secrets/object-secret-key
PACKAGE_BUCKET=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
LICENSE_ISSUER=
PACKAGE_STORE=postgres
LISTEN_HOST=0.0.0.0
PORT=8080
