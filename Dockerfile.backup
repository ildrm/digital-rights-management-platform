FROM node:24.21.0-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS node-runtime
FROM postgres:18.6@sha256:5a5a84b19854a9ffaa54082c166ff4ec27473a361e496e5ea167f298f2da9722

COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
COPY scripts/lib/standalone-backup.ts scripts/lib/standalone-backup.ts
COPY scripts/standalone-backup.ts scripts/standalone-backup-job.ts scripts/
USER root
CMD ["node", "--experimental-strip-types", "scripts/standalone-backup-job.ts"]
